# =============================================================================
# FreeBox — environment variables
# Copy this file to .env and fill in values. NEVER commit .env.
# =============================================================================

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=freebox_server=debug,tower_http=info

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://freebox:freebox_dev@localhost:5432/freebox

# --- Cache (Dragonfly / Redis-compatible) ---
REDIS_URL=redis://localhost:6379

# --- Message Queue (NATS JetStream) ---
NATS_URL=nats://localhost:4222

# --- Default Storage Provider ---
# Options: local | s3 | gcs | b2
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/tmp/freebox-data

# --- S3-compatible storage (MinIO in dev, AWS S3 in prod) ---
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_BUCKET=freebox
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin

# --- API protection ---
# Requests allowed per RATE_LIMIT_WINDOW_SECS window.
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECS=60

# Soft-deleted account auto-reactivation max age in days for OAuth login.
# Set to 0 to disable age limit.
OAUTH_REACTIVATION_MAX_AGE_DAYS=30

# Comma-separated UUID allowlist for admin-only audit APIs.
# Example: ADMIN_USER_IDS=11111111-1111-1111-1111-111111111111
ADMIN_USER_IDS=

# --- JWT Authentication ---
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# --- Argon2id parameters (password hashing) ---
# These values meet OWASP 2023 recommendations.
# Increase memory_kib for higher security (at cost of login latency).
ARGON2_MEMORY_KIB=65536   # 64 MB
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# --- Signal Protocol key server ---
# URL where prekey bundles are stored/retrieved.
# In most deployments this is the same as the main server.
KEY_SERVER_URL=http://localhost:8080

# --- OAuth2 Third-Party Authentication ---
# Each provider is optional. Only providers with all three values set are enabled.
# Register your app at the provider's developer console to get these values.

# GitHub: https://github.com/settings/developers
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/github/callback

# Google: https://console.cloud.google.com/apis/credentials
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

# Microsoft: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/microsoft/callback

# Apple: https://developer.apple.com/account/resources/identifiers
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_CLIENT_SECRET=
# OAUTH_APPLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/apple/callback

# Facebook: https://developers.facebook.com/apps
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=
# OAUTH_FACEBOOK_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/facebook/callback
